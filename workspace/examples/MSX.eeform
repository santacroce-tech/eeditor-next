;; MSX.eeform — an MSX1, running in a form.
;;
;; The machine is EELisp: the Spectrum's Z80 (src/spectrum/zx.eelisp) with an MSX around it —
;; its slots, the TMS9918A video chip, the PPI and the PSG (src/msx/msx.eelisp, loaded for a form
;; that calls msx-…). It boots C-BIOS, a free BIOS that comes with it (src/msx/cbios.eelisp), so
;; nothing needs downloading. The screen asks for a frame 60 times a second; each one runs 59,736
;; T-states of the Z80 and sends back the video chip's memory, which the host draws
;; ("tms9918" in docs/DISPLAY.md).
;;
;; C-BIOS runs cartridges — it has no BASIC. Without one it says so. Demo puts in a small
;; cartridge written for this form (below); Load cartridge… takes a .rom of up to 32 KB.
;;
;; Keys: the PC's letters, digits and punctuation are the MSX's (its international layout); Shift
;; is SHIFT, Ctrl is CTRL, Alt is GRAPH, the arrows are the cursor keys, Space and Enter are
;; theirs. Click the screen first.

(form "MSX" :size (560 480) :on-load msxapp-load
  (button btnCart :text "Load cartridge…" :at (16 12) :size (124 24) :on-click msxapp-pick-cart)
  (button btnDemo :text "Demo" :at (148 12) :size (64 24) :on-click msxapp-demo)
  (button btnReset :text "Reset" :at (220 12) :size (64 24) :on-click msxapp-do-reset)
  (button btnPause :text "Pause" :at (292 12) :size (64 24) :on-click msxapp-pause)
  (label lblStatus :at (368 16) :size (176 24))
  (screen scrMSX :frame "(msx-frame msx ui-held)" :hz 60 :at (16 48) :size (528 416)))

(def msx (msx-new msx-cbios-main msx-cbios-logo))
(def msxapp-cart nil)          ; the cartridge in, so Reset boots it again
(def msxapp-paused false)

(defn msxapp-say (text) (ui-set "lblStatus" :text text))
(defn msxapp-load (f) (msxapp-say "C-BIOS, no cartridge"))

;; Reset: the BIOS boots again, and runs the cartridge if there is one.
(defn msxapp-do-reset (f)
  (do (msx-reset msx)
      (msxapp-say (if msxapp-cart "running" "C-BIOS, no cartridge"))
      (ui-focus "scrMSX")))

(defn msxapp-put-in (rom name)
  (let (ok (msx-insert msx rom))
    (if (= ok true)
        (do (set! msxapp-cart rom) (msx-reset msx) (msxapp-say name) (ui-focus "scrMSX"))
        (ui-message ok))))

(defn msxapp-pick-cart (f) (ui-pick msxapp-got-cart))
(defn msxapp-got-cart (f) (msxapp-put-in (base64->bytes (ui-get f "$file")) (ui-get f "$filename")))

(defn msxapp-pause (f)
  (do (set! msxapp-paused (not msxapp-paused))
      (ui-set "scrMSX" :enabled (not msxapp-paused))
      (ui-set "btnPause" :text (if msxapp-paused "Resume" "Pause"))))

;; The demo cartridge, 285 bytes at 0x4000: the "AB" header C-BIOS looks for, then a program
;; that sets the colours, prints a few lines, and moves a sprite with the cursor keys — all
;; through the BIOS (INIT32 0x6F, CHPUT 0xA2, LDIRVM 0x5C, GTSTCK 0xD5, GTTRIG 0xD8, CHGCLR 0x62).
;; Hand-assembled:
;;   4000  41 42                    DB 'AB'
;;   4002  10 40                    DW INIT
;;   4004  00 00 00 00 00 00 00 00  DS 12
;;   4010                           INIT:
;;   4010  3E 0F                    LD A,15
;;   4012  32 E9 F3                 LD (FORCLR),A
;;   4015  3E 04                    LD A,4
;;   4017  32 EA F3                 LD (BAKCLR),A
;;   401A  32 EB F3                 LD (BDRCLR),A
;;   401D  CD 62 00                 CALL CHGCLR
;;   4020  CD 6F 00                 CALL INIT32
;;   4023  21 B5 40                 LD HL,TEXT
;;   4026                           PRINT:
;;   4026  7E                       LD A,(HL)
;;   4027  B7                       OR A
;;   4028  28 06                    JR Z,SHOWN
;;   402A  CD A2 00                 CALL CHPUT
;;   402D  23                       INC HL
;;   402E  18 F6                    JR PRINT
;;   4030                           SHOWN:
;;   4030  21 AD 40                 LD HL,SPRITE
;;   4033  11 00 38                 LD DE,0x3800
;;   4036  01 08 00                 LD BC,8
;;   4039  CD 5C 00                 CALL LDIRVM
;;   403C  3E 7C                    LD A,124
;;   403E  32 00 E0                 LD (X),A
;;   4041  3E 78                    LD A,120
;;   4043  32 01 E0                 LD (Y),A
;;   4046                           LOOP:
;;   4046  FB                       EI
;;   4047  76                       HALT
;;   4048  AF                       XOR A
;;   4049  CD D5 00                 CALL GTSTCK
;;   404C  87                       ADD A,A
;;   404D  5F                       LD E,A
;;   404E  16 00                    LD D,0
;;   4050  21 9B 40                 LD HL,STEPS
;;   4053  19                       ADD HL,DE
;;   4054  3A 00 E0                 LD A,(X)
;;   4057  86                       ADD A,(HL)
;;   4058  32 00 E0                 LD (X),A
;;   405B  23                       INC HL
;;   405C  3A 01 E0                 LD A,(Y)
;;   405F  86                       ADD A,(HL)
;;   4060  32 01 E0                 LD (Y),A
;;   4063  21 10 E0                 LD HL,ATTR
;;   4066  77                       LD (HL),A
;;   4067  23                       INC HL
;;   4068  3A 00 E0                 LD A,(X)
;;   406B  77                       LD (HL),A
;;   406C  23                       INC HL
;;   406D  36 00                    LD (HL),0
;;   406F  23                       INC HL
;;   4070  36 0B                    LD (HL),11
;;   4072  23                       INC HL
;;   4073  36 D0                    LD (HL),0xD0
;;   4075  21 10 E0                 LD HL,ATTR
;;   4078  11 00 1B                 LD DE,0x1B00
;;   407B  01 05 00                 LD BC,5
;;   407E  CD 5C 00                 CALL LDIRVM
;;   4081  AF                       XOR A
;;   4082  CD D8 00                 CALL GTTRIG
;;   4085  B7                       OR A
;;   4086  28 BE                    JR Z,LOOP
;;   4088  3A 02 E0                 LD A,(T)
;;   408B  3C                       INC A
;;   408C  32 02 E0                 LD (T),A
;;   408F  0F                       RRCA
;;   4090  0F                       RRCA
;;   4091  E6 0F                    AND 15
;;   4093  32 EB F3                 LD (BDRCLR),A
;;   4096  CD 62 00                 CALL CHGCLR
;;   4099  18 AB                    JR LOOP
;;   409B                           STEPS:
;;   409B  00 00 00 FE 02 FE 02 00  DB 0,0, 0,-2, 2,-2, 2,0, 2,2, 0,2, -2,2, -2,0, -2,-2
;;   40AD                           SPRITE:
;;   40AD  3C 7E DB FF FF DB 66 3C  DB smiley
;;   40B5                           TEXT:
;;   40B5  45 45 64 69 74 6F 72 20  DB "…", 0
(def msxapp-demo-cart
  (list->bytes
   '(
    0x41 0x42 0x10 0x40 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x3e 0x0f 0x32 0xe9 0xf3 0x3e 0x04 0x32 0xea 0xf3 0x32 0xeb 0xf3 0xcd 0x62 0x00
    0xcd 0x6f 0x00 0x21 0xb5 0x40 0x7e 0xb7 0x28 0x06 0xcd 0xa2 0x00 0x23 0x18 0xf6
    0x21 0xad 0x40 0x11 0x00 0x38 0x01 0x08 0x00 0xcd 0x5c 0x00 0x3e 0x7c 0x32 0x00
    0xe0 0x3e 0x78 0x32 0x01 0xe0 0xfb 0x76 0xaf 0xcd 0xd5 0x00 0x87 0x5f 0x16 0x00
    0x21 0x9b 0x40 0x19 0x3a 0x00 0xe0 0x86 0x32 0x00 0xe0 0x23 0x3a 0x01 0xe0 0x86
    0x32 0x01 0xe0 0x21 0x10 0xe0 0x77 0x23 0x3a 0x00 0xe0 0x77 0x23 0x36 0x00 0x23
    0x36 0x0b 0x23 0x36 0xd0 0x21 0x10 0xe0 0x11 0x00 0x1b 0x01 0x05 0x00 0xcd 0x5c
    0x00 0xaf 0xcd 0xd8 0x00 0xb7 0x28 0xbe 0x3a 0x02 0xe0 0x3c 0x32 0x02 0xe0 0x0f
    0x0f 0xe6 0x0f 0x32 0xeb 0xf3 0xcd 0x62 0x00 0x18 0xab 0x00 0x00 0x00 0xfe 0x02
    0xfe 0x02 0x00 0x02 0x02 0x00 0x02 0xfe 0x02 0xfe 0x00 0xfe 0xfe 0x3c 0x7e 0xdb
    0xff 0xff 0xdb 0x66 0x3c 0x45 0x45 0x64 0x69 0x74 0x6f 0x72 0x20 0x4d 0x53 0x58
    0x0d 0x0a 0x0d 0x0a 0x43 0x2d 0x42 0x49 0x4f 0x53 0x20 0x6f 0x6e 0x20 0x61 0x20
    0x5a 0x38 0x30 0x20 0x77 0x72 0x69 0x74 0x74 0x65 0x6e 0x0d 0x0a 0x69 0x6e 0x20
    0x45 0x45 0x4c 0x69 0x73 0x70 0x2e 0x0d 0x0a 0x0d 0x0a 0x43 0x75 0x72 0x73 0x6f
    0x72 0x20 0x6b 0x65 0x79 0x73 0x3a 0x20 0x6d 0x6f 0x76 0x65 0x20 0x74 0x68 0x65
    0x20 0x66 0x61 0x63 0x65 0x2e 0x0d 0x0a 0x53 0x70 0x61 0x63 0x65 0x3a 0x20 0x74
    0x68 0x65 0x20 0x62 0x6f 0x72 0x64 0x65 0x72 0x2e 0x0d 0x0a 0x00
)))

(defn msxapp-demo (f) (msxapp-put-in msxapp-demo-cart "demo"))
