<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS home-screen name (kept separate from the desktop productName "eeditor-next"). -->
	<key>CFBundleDisplayName</key>
	<string>EEditor</string>
	<!-- Expose the app's Documents folder in the Files app ("On My iPhone → EEditor") so the
	     user can add / edit / organize their .md files there and the app reads them in place. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- "Open in EEditor": receive notes handed over by other apps (Files, Mail, the share sheet).
	     Desktop declares the same thing through bundle.fileAssociations in tauri.conf.json; iOS needs
	     it spelled out here because the tauri bundler only emits CFBundleDocumentTypes for macOS.
	     Rank Alternate, not Owner — EEditor offers itself for .md/.txt without displacing whatever
	     the user already made the default. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EEditor Note</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>public.plain-text</string>
				<string>com.eeditor.app.eelisp</string>
				<string>com.eeditor.app.lisp</string>
			</array>
		</dict>
	</array>
	<!-- .eelisp / .lisp have no system UTI, so declare one each that conforms to plain text. Keep
	     these identifiers and their extensions identical to bundle.fileAssociations in
	     tauri.conf.json — a file that opens on the desktop should open on the phone too. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.eeditor.app.eelisp</string>
			<key>UTTypeDescription</key>
			<string>EELisp source file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
				<string>public.source-code</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.mime-type</key>
				<string>text/x-eelisp</string>
				<key>public.filename-extension</key>
				<array>
					<string>eelisp</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.eeditor.app.lisp</string>
			<key>UTTypeDescription</key>
			<string>Lisp source file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
				<string>public.source-code</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.mime-type</key>
				<string>text/x-lisp</string>
				<key>public.filename-extension</key>
				<array>
					<string>lisp</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
