{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "eeditor-next",
  "version": "2.0.0",
  "identifier": "com.eeditor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build && node scripts/prepare-ios-icons.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "eeditor-next",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown note",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown"]
      },
      {
        "ext": ["txt"],
        "name": "Plain Text Document",
        "description": "Plain text file",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain",
        "contentTypes": ["public.plain-text"]
      },
      {
        "ext": ["eelisp"],
        "name": "EELisp Source",
        "description": "EELisp source file",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-eelisp",
        "contentTypes": ["com.eeditor.app.eelisp"],
        "exportedType": {
          "identifier": "com.eeditor.app.eelisp",
          "conformsTo": ["public.plain-text", "public.source-code"]
        }
      },
      {
        "ext": ["lisp"],
        "name": "Lisp Source",
        "description": "Lisp source file",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/x-lisp",
        "contentTypes": ["com.eeditor.app.lisp"],
        "exportedType": {
          "identifier": "com.eeditor.app.lisp",
          "conformsTo": ["public.plain-text", "public.source-code"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "infoPlist": "Info.macos.plist"
    },
    "iOS": {
      "developmentTeam": "FFJKC46LZP",
      "minimumSystemVersion": "14.0",
      "bundleVersion": "2.0.5"
    }
  }
}