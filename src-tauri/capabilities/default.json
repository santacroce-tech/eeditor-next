{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the app window, and a form's screen control opened in a window of its own (screen-*)",
  "windows": [
    "main",
    "screen-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
