{
  "name": "eeditor-next",
  "version": "2.2.0",
  "private": true,
  "description": "EEditor — a notes editor with a database and a Lisp inside",
  "author": "Roberto Santacroce Martins <roberto@santacroce.xyz>",
  "license": "MIT",
  "repository": "https://github.com/santacroce-tech/eeditor-next",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node dev/bridge.mjs\" \"vite\"",
    "web": "vite",
    "bridge": "node dev/bridge.mjs",
    "tauri": "tauri",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node dev/smoke.mjs",
    "test:ui": "playwright test",
    "engine:wasm": "scripts/build-wasm-engine.sh",
    "runtime:template": "node scripts/build-runtime-template.mjs",
    "export-app": "vite-node scripts/export-app.ts --",
    "deploy:site": "scripts/deploy-site.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.30.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "codemirror": "^6.0.1",
    "marked": "^14.0.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
