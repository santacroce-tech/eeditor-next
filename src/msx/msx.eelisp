;; msx.eelisp — an MSX1, written in EELisp, on the Spectrum's Z80 (src/spectrum/zx.eelisp).
;;
;; What an MSX adds to the Z80 is here: its slots and their paging, the TMS9918A video chip's
;; ports and memory, the PPI (slot select and keyboard) and the PSG's registers. The picture is
;; the VDP's 16 KB of video memory and its eight registers, sent with each frame as a
;; "tms9918" frame (docs/DISPLAY.md); the host draws it (src/display/tms9918.ts), as it draws the
;; Spectrum's screen memory. See docs/msx/MSX.md.
;;
;; Public surface:
;;   (msx-new main logo)       a machine with a BIOS: main (32 KB, 0x0000) and logo (16 KB,
;;                             0x8000) in slot 0 — C-BIOS's (src/msx/cbios.eelisp) or another,
;;                             as bytes or base64; 64 KB of RAM in slot 3
;;   (msx-insert m rom)        a cartridge in slot 1 (bytes or base64, up to 32 KB); reset after
;;   (msx-reset m)             back to the start: the BIOS boots, finds the cartridge, runs it
;;   (msx-frame m held)        run one frame (59,736 T-states, 60 a second); held is ui-held, the
;;                             PC keys down; returns {"kind" "tms9918" "vram" … "regs" … "frame" n}
;;   (msx-vpeek m a)  (msx-vpoke m a v)   video memory
;;
;; Memory. The Z80 reads one flat 64 KB (zx-mem), which keeps its hot path the Spectrum's. Each
;; slot keeps its own 64 KB; port 0xA8 says which slot each 16 KB page shows, and a change copies
;; the page in (bcopy) — and a RAM page back out first. Only slot 3, the RAM, is writable: the
;; Z80 core sends writes below zx-rom-top here (zx-low-write), and zx-rom-top is set just above
;; the highest page that isn't RAM.

;; ---------------------------------------------------------------------------
;; State — offsets into the :st buffer
;; ---------------------------------------------------------------------------
(def msx-A8 0)        ; the primary slot register: two bits a page
(def msx-PPIC 1)      ; the PPI's port C (0xAA): keyboard row in bits 0–3, key click in bit 7
(def msx-VLATCH 2)    ; 1 when the VDP has the first byte of a two-byte command
(def msx-VFIRST 3)    ; that first byte
(def msx-VADDR 4)     ; the VRAM address, hi at 4, lo at 5
(def msx-VBUF 6)      ; the read-ahead byte
(def msx-VSTAT 7)     ; status: bit 7 the frame flag
(def msx-VREG 8)      ; the eight registers, 8–15
(def msx-PSGL 16)     ; the PSG's latched register
(def msx-PSG 17)      ; its sixteen registers, 17–32
(def msx-ST 40)

(def msx-FRAME-T 59736)   ; 3,579,545 Hz / 59.92 frames a second

;; The machine being run: msx-use points these at one machine's buffers, as zx-use does.
(def msx-st nil)
(def msx-vram nil)
(def msx-slots nil)
(def msx-mat nil)         ; the keyboard matrix: 11 rows, a 0 bit a key down
(def msx-irq false)       ; the VDP's interrupt line: frame flag and interrupts on

(defn msx-irq! ()
  (set! msx-irq (and (!= 0 (band (bget msx-st msx-VSTAT) 0x80))
                     (!= 0 (band (bget msx-st (+ msx-VREG 1)) 0x20)))))

;; ---------------------------------------------------------------------------
;; Slots and paging
;; ---------------------------------------------------------------------------
(defn msx-slot-of (page) (band (shr (bget msx-st msx-A8) (* 2 page)) 3))

;; Show slot `s` in `page`: a RAM page goes back to slot 3 first, then the new one comes in.
(defn msx-page! (page old new)
  (let (at (* page 0x4000))
    (do (when (= old 3) (bcopy (nth msx-slots 3) at zx-mem at 0x4000))
        (bcopy zx-mem at (nth msx-slots new) at 0x4000))))

(defn msx-rom-top! ()
  (set! zx-rom-top
        (loop (p 3)
          (cond (< p 0) 0
                (!= 3 (msx-slot-of p)) (* (+ p 1) 0x4000)
                true (recur (- p 1))))))

(defn msx-select! (v)
  (let (was (bget msx-st msx-A8))
    (do (bset msx-st msx-A8 v)
        (loop (p 0)
          (when (< p 4)
            (let (old (band (shr was (* 2 p)) 3) new (band (shr v (* 2 p)) 3))
              (do (when (!= old new) (msx-page! p old new))
                  (recur (+ p 1))))))
        (msx-rom-top!))))

;; A write below zx-rom-top: kept when its page shows the RAM; a ROM's is lost.
(defn msx-low-write (a v)
  (if (= 3 (msx-slot-of (shr a 14))) (bset zx-mem a v) nil))

;; ---------------------------------------------------------------------------
;; The VDP — TMS9918A: 0x98 data, 0x99 commands and status
;; ---------------------------------------------------------------------------
(defn msx-vaddr () (bor (shl (bget msx-st msx-VADDR) 8) (bget msx-st (+ msx-VADDR 1))))
(defn msx-vaddr! (a)
  (let (a (band a 0x3fff))
    (do (bset msx-st msx-VADDR (shr a 8)) (bset msx-st (+ msx-VADDR 1) a))))

(defn msx-vdp-write (v)
  (let (a (msx-vaddr))
    (do (bset msx-vram a v) (bset msx-st msx-VBUF v) (msx-vaddr! (+ a 1))
        (bset msx-st msx-VLATCH 0))))

(defn msx-vdp-read ()
  (let (a (msx-vaddr) v (bget msx-st msx-VBUF))
    (do (bset msx-st msx-VBUF (bget msx-vram a)) (msx-vaddr! (+ a 1))
        (bset msx-st msx-VLATCH 0)
        v)))

;; Two bytes: the first is data; the second says what — 10rrrrrr writes register r (three
;; bits on a TMS9918), 01aaaaaa sets the address for writing, 00aaaaaa for reading (and reads
;; ahead).
(defn msx-vdp-command (v)
  (if (= 0 (bget msx-st msx-VLATCH))
      (do (bset msx-st msx-VFIRST v) (bset msx-st msx-VLATCH 1))
      (let (first (bget msx-st msx-VFIRST))
        (do (bset msx-st msx-VLATCH 0)
            (cond (!= 0 (band v 0x80))
                    (do (bset msx-st (+ msx-VREG (band v 7)) first)
                        (when (= 1 (band v 7)) (msx-irq!)))
                  true
                    (do (msx-vaddr! (bor first (shl (band v 0x3f) 8)))
                        (when (= 0 (band v 0x40))
                          (let (a (msx-vaddr))
                            (do (bset msx-st msx-VBUF (bget msx-vram a)) (msx-vaddr! (+ a 1)))))))))))

;; Reading the status clears the frame flag, and with it the interrupt.
(defn msx-vdp-status ()
  (let (s (bget msx-st msx-VSTAT))
    (do (bset msx-st msx-VSTAT (band s 0x1f)) (bset msx-st msx-VLATCH 0) (msx-irq!) s)))

;; ---------------------------------------------------------------------------
;; The PSG's registers (sound comes later); register 14 is the joystick port, nothing plugged
;; ---------------------------------------------------------------------------
(defn msx-psg-read ()
  (let (r (bget msx-st msx-PSGL))
    (cond (= r 14) 0x7f
          (< r 16) (bget msx-st (+ msx-PSG r))
          true 0xff)))

;; ---------------------------------------------------------------------------
;; Ports
;; ---------------------------------------------------------------------------
(defn msx-in (port)
  (let (p (band port 0xff))
    (cond (= p 0x98) (msx-vdp-read)
          (= p 0x99) (msx-vdp-status)
          (= p 0xa9) (let (row (band (bget msx-st msx-PPIC) 0x0f)) (if (< row 11) (bget msx-mat row) 0xff))
          (= p 0xa8) (bget msx-st msx-A8)
          (= p 0xaa) (bget msx-st msx-PPIC)
          (= p 0xa2) (msx-psg-read)
          true 0xff)))

(defn msx-out (port v)
  (let (p (band port 0xff))
    (cond (= p 0x98) (msx-vdp-write v)
          (= p 0x99) (msx-vdp-command v)
          (= p 0xa8) (msx-select! v)
          (= p 0xaa) (bset msx-st msx-PPIC v)
          ;; 0xAB sets or clears one bit of port C: 0000bbbs
          (= p 0xab) (when (= 0 (band v 0x80))
                       (let (bit (shl 1 (band (shr v 1) 7)) c (bget msx-st msx-PPIC))
                         (bset msx-st msx-PPIC (if (= 1 (band v 1)) (bor c bit) (band c (bxor bit 0xff))))))
          (= p 0xa0) (bset msx-st msx-PSGL (band v 0x0f))
          (= p 0xa1) (bset msx-st (+ msx-PSG (bget msx-st msx-PSGL)) v)
          true nil)))

;; ---------------------------------------------------------------------------
;; The keyboard: the PC keys held, onto the MSX's matrix (the international layout)
;; ---------------------------------------------------------------------------
(def msx-keymap                 ; code → row × 8 + bit
  {"Digit0" 0 "Digit1" 1 "Digit2" 2 "Digit3" 3 "Digit4" 4 "Digit5" 5
   "Digit6" 6 "Digit7" 7 "Digit8" 8 "Digit9" 9 "Minus" 10 "Equal" 11
   "Backslash" 12 "BracketLeft" 13 "BracketRight" 14 "Semicolon" 15
   "Quote" 16 "Backquote" 17 "Comma" 18 "Period" 19 "Slash" 20
   "KeyA" 22 "KeyB" 23 "KeyC" 24 "KeyD" 25 "KeyE" 26 "KeyF" 27 "KeyG" 28
   "KeyH" 29 "KeyI" 30 "KeyJ" 31 "KeyK" 32 "KeyL" 33 "KeyM" 34 "KeyN" 35
   "KeyO" 36 "KeyP" 37 "KeyQ" 38 "KeyR" 39 "KeyS" 40 "KeyT" 41 "KeyU" 42
   "KeyV" 43 "KeyW" 44 "KeyX" 45 "KeyY" 46 "KeyZ" 47
   "ShiftLeft" 48 "ShiftRight" 48 "ControlLeft" 49 "ControlRight" 49
   "AltLeft" 50 "AltRight" 52
   "Backspace" 61 "Enter" 63 "NumpadEnter" 63
   "Space" 64 "ArrowLeft" 68 "ArrowUp" 69 "ArrowDown" 70 "ArrowRight" 71})

(defn msx-keys! (held)
  (do (bfill msx-mat 0 11 0xff)
      (when held
        (for-each k (dict-keys held)
          (let (rb (dict-get msx-keymap k))
            (when rb
              (let (row (shr rb 3))
                (bset msx-mat row (band (bget msx-mat row) (bxor (shl 1 (band rb 7)) 0xff))))))))))

;; ---------------------------------------------------------------------------
;; The machine
;; ---------------------------------------------------------------------------
(defn msx-bytes (data) (if (string? data) (base64->bytes data) data))

;; zx-rom-top is the Z80's, and a Spectrum in the same engine needs it back as it was: every
;; entry point here that moves it puts it back when it's done.
(defn msx-back (saved v) (do (set! zx-rom-top saved) v))

(defn msx-use (m)
  (do (zx-use m)
      (set! msx-st (dict-get m :st))
      (set! msx-vram (dict-get m :vram))
      (set! msx-slots (dict-get m :slots))
      (set! msx-mat (dict-get m :mat))
      (msx-rom-top!)
      (msx-irq!)
      m))

(defn msx-new (main logo)
  (let (bios (make-bytes 65536 0xff)
        m {:mem (make-bytes 65536 0xff) :reg (make-bytes zx-REGS) :keys (make-bytes 8 0xff)
           :st (make-bytes msx-ST) :vram (make-bytes 16384) :mat (make-bytes 11 0xff)
           :slots (list bios (make-bytes 65536 0xff) (make-bytes 65536 0xff) (make-bytes 65536))
           :in msx-in :out msx-out :low-write msx-low-write})
    (do (when main (let (b (msx-bytes main)) (bcopy bios 0 b 0 (min 0x8000 (bytes-len b)))))
        (when logo (let (b (msx-bytes logo)) (bcopy bios 0x8000 b 0 (min 0x4000 (bytes-len b)))))
        (msx-reset m))))

;; A cartridge in slot 1. Up to 32 KB, at 0x4000 — where nearly every one starts; one of 16 KB
;; or less shows again at 0x8000, as a cartridge that decodes no more address lines does.
;; (Bigger ones, with a mapper, are for later.)
(defn msx-insert (m rom)
  (let (b (msx-bytes rom) n (bytes-len b) cart (nth (dict-get m :slots) 1))
    (do (bfill cart 0 65536 0xff)
        (cond (> n 0x8000) (str "msx-insert: " n " bytes — a cartridge with a mapper isn't supported yet (32 KB at most)")
              (> n 0x4000) (do (bcopy cart 0x4000 b 0 n) true)
              true (loop (at 0x4000)
                     (if (>= at 0xc000)
                         true
                         (do (bcopy cart at b 0 (min n 0x4000)) (recur (+ at (max n 0x2000))))))))))

(defn msx-reset (m)
  (let (saved zx-rom-top)
  (do (zx-use m)
      (let (st (dict-get m :st) reg (dict-get m :reg))
        (do (bfill st 0 msx-ST 0)
            (bfill reg 0 zx-REGS 0)
            (bfill (dict-get m :vram) 0 16384 0)
            (bfill (nth (dict-get m :slots) 3) 0 65536 0)
            ;; every page on slot 0, the BIOS: it finds the RAM itself
            (bcopy (dict-get m :mem) 0 (nth (dict-get m :slots) 0) 0 65536)
            (msx-use m)
            (zx-rr! zx-SP 0xf000) (zx-r! zx-A 0xff) (zx-r! zx-F 0xff)
            (msx-back saved m)))))))

(defn msx-frame (m held)
  (let (saved zx-rom-top)
  (do (msx-use m)
      (msx-keys! held)
      (let (end (loop (t (zx-r zx-TCARRY))
                  (cond (>= t msx-FRAME-T) t
                        ;; halted, with no interrupt to wake it: nothing more this frame
                        (and (= 1 (zx-r zx-HALT)) (not msx-irq)) msx-FRAME-T
                        true (recur (+ t (zx-exec msx-irq))))))
        (do (zx-r! zx-TCARRY (- end msx-FRAME-T))
            (zx-r! zx-FRAME (+ (zx-r zx-FRAME) 1))
            ;; the frame is drawn: the VDP raises its flag, and the interrupt if it's on
            (bset msx-st msx-VSTAT (bor (bget msx-st msx-VSTAT) 0x80))
            (msx-irq!)
            (msx-back saved
              {"kind" "tms9918"
               "vram" (bytes->base64 msx-vram)
               "regs" (bytes->base64 msx-st msx-VREG 8)
               "frame" (zx-r zx-FRAME)}))))))

(defn msx-vpeek (m a) (bget (dict-get m :vram) (band a 0x3fff)))
(defn msx-vpoke (m a v) (bset (dict-get m :vram) (band a 0x3fff) v))
