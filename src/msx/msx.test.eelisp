;; msx.test.eelisp — the MSX around the Z80: slots and paging, the VDP's ports, the frame's
;; interrupt, the keyboard matrix, and C-BIOS booting. Run with: npm run msx:test

(def msx-failures 0)
(defn check (name got want)
  (if (= got want)
      (println "ok   " name)
      (do (set! msx-failures (+ msx-failures 1))
          (println "FAIL " name " — got " got ", want " want))))

;; a BIOS whose every byte is 0xB1, so it can be told from RAM (0) and an empty slot (0xFF)
(def m (msx-new (make-bytes 0x8000 0xb1) nil))
(msx-use m)

;; ── slots ──
(check "at reset every page shows slot 0" (list (zx-rd 0x0000) (zx-rd 0x8000) (zx-rd 0xc000)) (list 0xb1 0xff 0xff))
(check "nothing is writable on a ROM" (do (zx-wr 0x1000 7) (zx-rd 0x1000)) 0xb1)
(msx-out 0xa8 0xc0)                                  ; page 3 → slot 3, the RAM
(check "page 3 on the RAM reads it" (zx-rd 0xc000) 0)
(check "and writes it" (do (zx-wr 0xc000 0x42) (zx-rd 0xc000)) 0x42)
(check "zx-rom-top sits just under the RAM" zx-rom-top 0xc000)
(msx-out 0xa8 0x00)                                  ; page 3 back to the BIOS slot
(check "away from the RAM, page 3 is the slot's" (zx-rd 0xc000) 0xff)
(msx-out 0xa8 0xf0)                                  ; pages 2 and 3 on the RAM
(check "back on the RAM, what was written is there" (zx-rd 0xc000) 0x42)
(check "port 0xA8 reads back" (msx-in 0xa8) 0xf0)
(msx-out 0xa8 0xff)                                  ; all RAM
(check "all RAM: nothing is a ROM" zx-rom-top 0)
(check "the bottom page writes too" (do (zx-wr 0x0010 9) (zx-rd 0x0010)) 9)
(msx-out 0xa8 0xf0)
(check "the BIOS comes back under it" (zx-rd 0x0010) 0xb1)

;; ── the cartridge slot ──
(msx-insert m (list->bytes '(0x41 0x42 0x10 0x40)))
(msx-use m)
(msx-out 0xa8 0xf4)                                  ; page 1 → slot 1
(check "a cartridge shows in slot 1 at 0x4000" (list (zx-rd 0x4000) (zx-rd 0x4001)) (list 0x41 0x42))
(check "a small one again at 0x6000" (zx-rd 0x6000) 0x41)
(check "one over 2 MB is refused" (string? (msx-insert m (make-bytes 0x200001))) true)
(check "so is a mapper nobody makes" (string? (msx-insert-as m (make-bytes 0x10000) "acme")) true)

;; ── mappers ──
;; a ROM of n 8 KB banks, each filled with its own number: a read says which bank is where
(defn stamped (n)
  (let (b (make-bytes (* n 0x2000)))
    (loop (k 0) (if (= k n) b (do (bfill b (* k 0x2000) 0x2000 k) (recur (+ k 1)))))))
;; a ROM of 64 KB whose code writes A to these addresses (LD (nnnn),A), for the guess
(defn writing (addrs)
  (let (b (make-bytes 0x10000 0))
    (loop (i 0 l addrs)
      (if (empty? l) b
          (do (bset b i 0x32) (bset b (+ i 1) (band (first l) 0xff)) (bset b (+ i 2) (shr (first l) 8))
              (recur (+ i 3) (cdr l)))))))
(check "the guess: Konami SCC" (msx-guess-mapper (writing '(0x5000 0x7000 0x9000 0xb000))) "konami-scc")
(check "the guess: Konami" (msx-guess-mapper (writing '(0x6000 0x8000 0xa000))) "konami")
(check "the guess: ASCII 8" (msx-guess-mapper (writing '(0x6000 0x6800 0x7000 0x7800))) "ascii8")
(check "the guess: ASCII 16" (msx-guess-mapper (writing '(0x6000 0x77ff 0x77ff))) "ascii16")
(check "32 KB is plain ROM, no mapper" (do (msx-insert m (stamped 4)) (msx-cart-mapper m)) nil)
(check "over 32 KB a mapper is guessed" (do (msx-insert m (stamped 16)) (msx-cart-mapper m)) "ascii8")

;; slot 1 on pages 1 and 2, the RAM on page 3
(defn on-cart (rom mapper)
  (do (msx-insert-as m rom mapper) (msx-reset m) (msx-use m) (msx-out 0xa8 0xd4)))
(defn regions () (list (zx-rd 0x4000) (zx-rd 0x6000) (zx-rd 0x8000) (zx-rd 0xa000)))

(on-cart (stamped 16) "ascii8")
(check "ASCII 8 starts on bank 0 everywhere" (regions) (list 0 0 0 0))
(zx-wr 0x6000 1) (zx-wr 0x6800 2) (zx-wr 0x7000 3) (zx-wr 0x7800 4)
(check "and a write at 0x6000/0x6800/0x7000/0x7800 picks each region's" (regions) (list 1 2 3 4))
(zx-wr 0x7800 17)
(check "a bank past the end wraps round" (zx-rd 0xa000) 1)
(msx-out 0xa8 0xf4) (msx-out 0xa8 0xd4)                ; page 2 away to the RAM and back
(check "the banks stay put while the page is away" (regions) (list 1 2 3 1))
(zx-wr 0x4000 9)
(check "the ROM isn't written" (zx-rd 0x4000) 1)
(msx-reset m) (msx-use m) (msx-out 0xa8 0xd4)
(check "reset puts the banks back" (regions) (list 0 0 0 0))

(on-cart (stamped 16) "ascii16")
(check "ASCII 16 starts on bank 0 in both halves" (regions) (list 0 1 0 1))
(zx-wr 0x6000 3) (zx-wr 0x77ff 5)
(check "0x6000 and 0x7000 pick 16 KB each" (regions) (list 6 7 10 11))

(on-cart (stamped 16) "konami")
(check "Konami starts on banks 0 1 2 3" (regions) (list 0 1 2 3))
(zx-wr 0x4000 7) (zx-wr 0x6000 5) (zx-wr 0x8000 6) (zx-wr 0xa000 9)
(check "0x4000 stays bank 0; 0x6000, 0x8000, 0xA000 pick the rest" (regions) (list 0 5 6 9))

(on-cart (stamped 64) "konami-scc")
(check "Konami SCC starts on banks 0 1 2 3" (regions) (list 0 1 2 3))
(zx-wr 0x5000 4) (zx-wr 0x7000 5) (zx-wr 0x9000 6) (zx-wr 0xb000 7)
(check "0x5000, 0x7000, 0x9000, 0xB000 pick the four" (regions) (list 4 5 6 7))
(check "the SCC isn't there yet: 0x9800 is ROM" (do (zx-wr 0x9800 0x40) (zx-rd 0x9800)) 6)
(zx-wr 0x9000 0x3f)
(check "bank 0x3F at 0x8000 brings the SCC: a waveform reads back" (do (zx-wr 0x9800 0x40) (zx-rd 0x9800)) 0x40)
(check "and the rest of the page is bank 0x3F" (zx-rd 0x8000) 0x3f)
(check "a silent SCC makes no sound" (msx-psg-frame) nil)
(loop (i 0) (when (< i 32) (do (zx-wr (+ 0x9800 i) (if (< i 16) 0x60 0xa0)) (recur (+ i 1)))))   ; a square wave
(zx-wr 0x9880 0xfe) (zx-wr 0x9881 0x00)             ; channel 1: 3,579,545 / 32 / 255 ≈ 439 Hz
(zx-wr 0x988a 15) (zx-wr 0x988f 1)                   ; loud, and on
(def scc-pcm (msx-psg-frame))
(check "channel 1 on: the frame has sound" (string? scc-pcm) true)
(check "a square wave: both sides of 128" (let (b (base64->bytes scc-pcm) l (map (fn (i) (bget b i)) (range 368))) (list (> (apply max l) 128) (< (apply min l) 128))) (list true true))
(zx-wr 0x9890 0x00)                                  ; 0x9890 repeats 0x9880
(check "the registers repeat at 0x9890" (bget msx-scc 0x80) 0)
(zx-wr 0x9000 0)
(check "another bank at 0x8000 hides the SCC again" (do (zx-wr 0x988f 0) (bget msx-scc 0x8f)) 1)
(msx-insert m (list->bytes '(0x41 0x42 0x10 0x40)))

;; ── the VDP ──
(msx-out 0x99 0x34) (msx-out 0x99 0x52)              ; write at 0x1234
(msx-out 0x98 0xaa) (msx-out 0x98 0xbb)
(check "data goes to VRAM and the address moves on" (list (msx-vpeek m 0x1234) (msx-vpeek m 0x1235)) (list 0xaa 0xbb))
(msx-out 0x99 0x34) (msx-out 0x99 0x12)              ; read from 0x1234: read ahead
(check "reads come from the read-ahead" (list (msx-in 0x98) (msx-in 0x98)) (list 0xaa 0xbb))
(msx-out 0x99 0xf4) (msx-out 0x99 0x87)              ; register 7 = 0xF4
(check "a register write" (bget msx-st (+ msx-VREG 7)) 0xf4)

;; ── the frame and its interrupt ──
(msx-out 0x99 0xe0) (msx-out 0x99 0x81)              ; r1: display and interrupts on
(bset msx-st msx-VSTAT 0x80) (msx-irq!)
(check "the frame flag with interrupts on asks for one" msx-irq true)
(check "reading the status gives the flag" (msx-in 0x99) 0x80)
(check "and clears it, and the interrupt" (list (bget msx-st msx-VSTAT) msx-irq) (list 0 false))

;; ── the keyboard ──
(msx-keys! {"KeyA" true "ArrowUp" true})
(msx-out 0xaa 0x02)                                  ; row 2
(check "A is row 2, bit 6" (msx-in 0xa9) 0xbf)
(msx-out 0xab 0x07)                                  ; port C was row 2; bit 3 set: row 10
(msx-out 0xab 0x02)                                  ; bit 1 cleared: row 8
(check "0xAB sets or clears one bit of port C" (band (msx-in 0xaa) 0x0f) 0x08)
(msx-out 0xaa 0x08)
(check "↑ is row 8, bit 5" (msx-in 0xa9) 0xdf)
(msx-keys! {})
(check "let go, the row is all 1s" (msx-in 0xa9) 0xff)

;; ── C-BIOS boots, and with no cartridge says so ──
(def cb (msx-new msx-cbios-main msx-cbios-logo))
(loop (i 0) (when (< i 240) (do (msx-frame cb {}) (recur (+ i 1)))))
(def vram (dict-get cb :vram))
(defn find-bytes (want)
  (let (n (length want))
    (loop (a 0)
      (cond (> a (- 16384 n)) -1
            (= want (map (fn (i) (bget vram (+ a i))) (range n))) a
            true (recur (+ a 1))))))
;; "No cartridge" in the text screen's names
(check "C-BIOS says it has no cartridge" (> (find-bytes '(78 111 32 99 97 114 116 114 105 100 103 101)) -1) true)

;; ── the PSG's sound ──
(def snd (msx-new (make-bytes 0x8000 0x76) nil))     ; a BIOS of HALTs: the Z80 does nothing
(defn psg! (r v) (do (msx-use snd) (msx-out 0xa0 r) (msx-out 0xa1 v)))
(defn samples (f) (let (a (dict-get f "audio")) (if a (bytes->list (base64->bytes (dict-get a "pcm"))) nil)))
(defn edges (xs) (loop (xs (tail xs) prev (first xs) n 0)
                   (if (empty? xs) n (recur (tail xs) (first xs) (if (= (first xs) prev) n (+ n 1))))))
(check "a silent PSG sends no sound" (dict-get (msx-frame snd {}) "audio") nil)
(psg! 0 254) (psg! 1 0) (psg! 7 0xbe) (psg! 8 15)    ; A: 440 Hz, tone only, full volume
(def a440 (samples (msx-frame snd {})))
(check "a frame of sound at 22,050 a second" (> (length a440) 366) true)
(check "a frame's samples follow on: 368 and 367" (< (length a440) 369) true)
(check "the rate" (dict-get (dict-get (msx-frame snd {}) "audio") "rate") 22050)
(check "440 Hz is about 15 edges in a 60th of a second" (let (e (edges (samples (msx-frame snd {})))) (and (>= e 13) (<= e 16))) true)
(check "full volume swings 40 either side of 128" (list (apply min a440) (apply max a440)) (list 88 168))
(psg! 8 0)
(check "volume 0 is silence again" (dict-get (msx-frame snd {}) "audio") nil)
;; the envelope: shape 0 falls from 15 to 0 once and stays there
(psg! 8 16) (psg! 11 0) (psg! 12 4) (psg! 13 0)       ; A follows the envelope, 16·1024 cycles a step
(def falling (samples (msx-frame snd {})))
(check "the envelope starts loud" (apply max falling) 168)
(loop (i 0) (when (< i 40) (do (msx-frame snd {}) (recur (+ i 1)))))
(check "and once it has faded out the frame sends no sound" (dict-get (msx-frame snd {}) "audio") nil)
;; noise alone on A
(psg! 8 15) (psg! 7 0xb7) (psg! 6 1)
(check "noise is noise: many edges" (> (edges (samples (msx-frame snd {}))) 30) true)

;; ── a Spectrum in the same engine keeps its memory map ──
(def zx (zx-new))
(msx-frame cb {})
(zx-load zx 0x8000 (list->bytes '(0x3e 0x55 0x32 0x00 0x40 0x76)))   ; LD A,0x55 / LD (0x4000),A / HALT
(zx-set-reg zx "pc" 0x8000)
(zx-frame zx nil)
(check "after an MSX frame, the Spectrum still writes its screen" (zx-peek zx 0x4000) 0x55)

(println)
(println (if (= msx-failures 0) "all passed" (str msx-failures " failed")))
